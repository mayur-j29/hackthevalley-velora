# Optional live Gemini explanations (Vercel server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Supabase: use the same project URL and anon key under both names.
# Never put a service_role key in the browser or commit it to Git.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Twelve Data stock directory and candle data (server-side only)
TWELVE_DATA_API_KEY=

# Plaid Sandbox only (never use production keys with this app)
PLAID_CLIENT_ID=
PLAID_SECRET=

# Optional Alpaca market-data credentials (server-side only; IEX feed)
ALPACA_API_KEY=
ALPACA_API_SECRET=
